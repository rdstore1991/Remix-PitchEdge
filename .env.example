# Third-party sports data API keys for PitchEdge live connectors.
# AI Studio injects configured values at build time from the Secrets panel.
# Firebase AI Logic uses App Check attestation and does NOT require GEMINI_API_KEY.

# CRIC_API_KEY: Required for CricAPI live cricket scores and scorecards (api.cricapi.com).
CRIC_API_KEY=MY_CRIC_API_KEY

# ODDS_API_KEY: Required for The Odds API v4 live decimal odds and vig-free probabilities (api.the-odds-api.com).
ODDS_API_KEY=MY_ODDS_API_KEY
